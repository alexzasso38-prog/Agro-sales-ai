# Copiare in .env alla radice. Nessuna credenziale necessaria per la demo.
DEMO_MODE=true
ALLOW_EXTERNAL_INTEGRATIONS=false
# Vuoto: SQLite backend/data/agro.db. In produzione usare PostgreSQL.
# DATABASE_URL=postgresql+psycopg://agro:password@localhost:5432/agro
# JWT_SECRET=impostare-un-valore-casuale-di-almeno-32-caratteri-in-produzione
TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Impostare DEMO_MODE=false e ALLOW_EXTERNAL_INTEGRATIONS=true per le integrazioni.
# Le chiavi rimangono solo nel backend. Non aggiungere variabili VITE_* per segreti.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMAIL_PROVIDER_URL=
EMAIL_API_KEY=
EMAIL_FROM=
SEARCH_PROVIDER_URL=
SEARCH_API_KEY=
CALENDAR_PROVIDER_URL=
CALENDAR_API_KEY=
CRM_PROVIDER_URL=
CRM_API_KEY=
# Modulo telefonico predisposto, nessuna telefonata implementata.
VOICE_PROVIDER_URL=
VOICE_API_KEY=
